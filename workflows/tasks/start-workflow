#!/bin/bash
# Start a workflow with its tmux layout

set -euo pipefail

# Source machine-local env (SHORTCUT_REPO_URL, etc.) — env-only file, safe in
# this non-interactive context where ~/.profile isn't sourced.
[ -f "$HOME/.profile.local" ] && source "$HOME/.profile.local"

# Source shared utilities
source "$(dirname "$0")/../shared.sh"

# Parse flags
detached=false
has_prompt=true
print_prompt=false
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --detached)     detached=true ;;
        --no-prompt)    has_prompt=false ;;
        --print-prompt) print_prompt=true ;;
    esac
    shift
done

# --print-prompt requires the prompt to be composed
if [ "$print_prompt" = true ]; then
    has_prompt=true
fi

workflow_name="$1"
shift

if [ -z "$workflow_name" ]; then
    echo "Usage: start-workflow [--detached] <workflow-name> [args...]" >&2
    exit 1
fi

# Get the prompt file
prompt_file="$(dirname "$0")/../prompts/${workflow_name}.md"

if [ ! -f "$prompt_file" ]; then
    echo "Error: Workflow prompt not found: $prompt_file" >&2
    exit 1
fi

# Set default target directory
target_dir="${PWD}"

# Execute setup tasks if defined in frontmatter and capture output
# Skipped in --print-prompt mode (no side effects).
if [ "$print_prompt" = false ]; then
    setup_tasks=$(parse_frontmatter "$prompt_file" "setup_tasks")
    if [ -n "$setup_tasks" ]; then
        echo "Running setup tasks..." >&2

        # Process each setup task and capture directory output
        while IFS= read -r task_command; do
            # Replace template variables with workflow arguments
            if [ $# -gt 0 ]; then
                for i in $(seq 1 $#); do
                    arg_var="{{arg$i}}"
                    task_command="${task_command//$arg_var/${!i}}"
                done
            fi

            # Make relative paths absolute
            if [[ "$task_command" == "./workflows/tasks/"* ]]; then
                task_command="${task_command#./workflows/tasks/}"
                task_command="$(dirname "$0")/$task_command"
            fi

            echo "Executing: $task_command" >&2
            result=$(eval "$task_command")

            # If task outputs a directory path, use it as target_dir
            # Use the last line if there are multiple lines
            last_line=$(echo "$result" | tail -1)
            if [ -n "$last_line" ] && [ -d "$last_line" ] 2>/dev/null; then
                target_dir="$last_line"
                echo "Updated target directory to: $target_dir" >&2
            fi
        done < <(echo "$setup_tasks" | yq -r '.[]')
    fi
fi

# Parse tmux configuration from frontmatter
# Windows come ONLY from the prompt's frontmatter — no fallthrough to .workflow.yml
windows_yaml=$(parse_frontmatter "$prompt_file" "tmux_windows")
custom_session_name=$(parse_frontmatter "$prompt_file" "tmux_session_name")

# Build the AI CLI command with explicit --model (falls back to Opus so
# we don't inherit whatever model claude last ran with).
# WORKFLOW_MODEL/WORKFLOW_EFFORT let a caller override the prompt's pinned
# values, matching the WORKFLOW_AI_CLI override below.
model="${WORKFLOW_MODEL:-$(parse_frontmatter "$prompt_file" "model")}"
effort="${WORKFLOW_EFFORT:-$(parse_frontmatter "$prompt_file" "effort")}"
ai_cli="${WORKFLOW_AI_CLI:-claude} --model '${model:-opus}'"
[ -n "$effort" ] && ai_cli="$ai_cli --effort '$effort'"

workflow_yml="$target_dir/.workflow.yml"
is_worktree=false
if [ -f "$target_dir/.git" ]; then
    is_worktree=true
fi

# Worktree setup runs before the prompt is composed so the environment block
# below can read what it generated (mise.local.toml).
if [ "$print_prompt" = false ] && [ "$is_worktree" = true ]; then
    run_worktree_setup "$target_dir"
    pretrust_worktree "$target_dir"
fi

# The repo's .workflow.yml can describe the worktree's environment for the
# session; {{env}} expands to the KEY=VALUE lines of mise.local.toml.
worktree_prompt_text() {
    local text env_lines
    [ "$is_worktree" = true ] && [ -f "$workflow_yml" ] || return 0
    text=$(yq eval '.worktree.prompt // ""' "$workflow_yml")
    [ -n "$text" ] || return 0
    env_lines=""
    if [ -f "$target_dir/mise.local.toml" ]; then
        env_lines=$(grep -E '^[A-Z_0-9]+ = ' "$target_dir/mise.local.toml" | sed -E 's/ = "?([^"]*)"?$/=\1/')
    fi
    printf '\n'
    while IFS= read -r line; do
        if [[ "$line" == *"{{env}}"* ]]; then
            printf '%s\n' "$env_lines"
        else
            printf '%s\n' "$line"
        fi
    done <<< "$text"
}

# The repo's worktree.windows (per-worktree chores like DB setup) follow the
# prompt's own windows; the base windows: list is never used for worktrees.
if [ -n "$windows_yaml" ] && [ "$is_worktree" = true ] && [ -f "$workflow_yml" ]; then
    worktree_windows=$(yq eval '.worktree.windows // [] | map({"name": (keys | .[0]), "command": (to_entries | .[0].value)})' "$workflow_yml")
    if [ -n "$worktree_windows" ] && [ "$worktree_windows" != "[]" ]; then
        windows_yaml=$(printf '%s\n%s\n' "$windows_yaml" "$worktree_windows")
    fi
fi

processed_prompt=""
if [ "$has_prompt" = true ]; then
    # Get available tasks
    available_tasks=$(list_available_tasks)

    # Create a processed prompt file with system prompt prepended and template variables replaced
    system_prompt="$(dirname "$0")/../prompts/_system.md"
    processed_prompt="/tmp/workflow-prompt-$$"

    # Create temp file for available tasks to handle multiline content
    tasks_file="/tmp/workflow-tasks-$$"
    echo "$available_tasks" > "$tasks_file"

    # Combine system prompt with workflow prompt content (excluding frontmatter), replacing template variables
    {
        # Replace {{available_tasks}} with file content using a different approach
        while IFS= read -r line; do
            if [[ "$line" == *"{{available_tasks}}"* ]]; then
                cat "$tasks_file"
            else
                echo "$line"
            fi
        done < "$system_prompt"
        # Extract only the content after the frontmatter (after second ---)
        awk '/^---$/{if(++c==2) f=1; next} f' "$prompt_file"
        worktree_prompt_text
        # WORKFLOW_BRIEF=<file>: a launcher's brief (what to build, what is decided,
        # where results go) rides along with the prompt, for jobs queued by another session.
        if [ -n "${WORKFLOW_BRIEF:-}" ] && [ -f "$WORKFLOW_BRIEF" ]; then
            printf '\n# Brief from the launcher (%s)\n\n' "$WORKFLOW_BRIEF"
            cat "$WORKFLOW_BRIEF"
            echo
        fi
    } | {
        # Replace argument template variables ({{arg1}}, {{arg2}}, etc.)
        if [ $# -gt 0 ]; then
            content=$(cat)
            for i in $(seq 1 $#); do
                arg_var="{{arg$i}}"
                content=$(echo "$content" | sed "s|$arg_var|${!i}|g")
            done
            echo "$content"
        else
            cat
        fi
    } > "$processed_prompt"

    # For testing: allow preserving the processed prompt file
    if [ -n "${TEST_PROMPT_OUTPUT:-}" ]; then
        cp "$processed_prompt" "$TEST_PROMPT_OUTPUT"
    fi

    # Print-only mode: emit the composed prompt and exit before any tmux work.
    if [ "$print_prompt" = true ]; then
        cat "$processed_prompt"
        rm -f "$processed_prompt" "$tasks_file"
        exit 0
    fi

    trap "rm -f '$processed_prompt' '$tasks_file'" EXIT
fi

# Create session with custom layout if windows are defined
if [ -n "$windows_yaml" ]; then
    # Parse windows and create session
    # Use custom session name if provided, otherwise use directory basename
    if [ -n "$custom_session_name" ]; then
        session_name="$custom_session_name"
    else
        session_name=$(basename "$target_dir")
    fi
    existing_for_dir=$(session_for_path "$target_dir")
    [ -n "$existing_for_dir" ] && session_name="$existing_for_dir"

    # Check if session already exists
    if tmux has-session -t "=$session_name" 2>/dev/null; then
        echo "Session $session_name already exists" >&2

        # Find the AI window and clear it, or create one if it doesn't exist
        ai_window=$(tmux list-windows -t "$session_name" -F "#{window_index}:#{window_name}" | grep ":ai$" | cut -d: -f1 || true)

        if [ -n "$ai_window" ]; then
            echo "Clearing AI window context..." >&2
            tmux send-keys -t "$session_name:$ai_window" "/clear" C-m
            sleep 1

            # Send the new prompt
            if [ -n "$processed_prompt" ] && [ -f "$processed_prompt" ]; then
                echo "Sending new prompt to AI window..." >&2
                prompt_content=$(cat "$processed_prompt")
                tmux send-keys -t "$session_name:$ai_window" "$prompt_content"
                sleep 0.5
                tmux send-keys -t "$session_name:$ai_window" C-m
            fi
        else
            echo "Creating AI window..." >&2
            # Create new AI window in target directory
            tmux new-window -t "$session_name" -n "ai" -c "$target_dir"
            ai_window=$(tmux list-windows -t "$session_name" -F "#{window_index}:#{window_name}" | grep ":ai$" | cut -d: -f1)

            # Swap AI window to first position
            tmux swap-window -s "$session_name:$ai_window" -t "$session_name:1"
            ai_window="1"

            # Start AI CLI
            command="$ai_cli"
            sleep 0.3
            tmux send-keys -t "$session_name:$ai_window" "$command" C-m

            # Wait for CLI to start and send prompt
            if [ -n "$processed_prompt" ] && [ -f "$processed_prompt" ]; then
                sleep 3
                echo "Sending prompt to new AI window..." >&2
                # Send Enter first to clear any prompts/banners
                tmux send-keys -t "$session_name:$ai_window" C-m
                sleep 0.5
                prompt_content=$(cat "$processed_prompt")
                tmux send-keys -t "$session_name:$ai_window" "$prompt_content"
                sleep 0.5
                tmux send-keys -t "$session_name:$ai_window" C-m
            fi
        fi

        if [ "$detached" = false ]; then
            echo "Switching to it" >&2
            if [ -n "${TMUX:-}" ]; then
                tmux switch-client -t "$session_name"
            else
                tmux attach-session -t "$session_name"
            fi
        fi
    else
        # Create session starting in target directory
        tmux new-session -d -s "$session_name" -c "$target_dir"

        # Give tmux a moment to fully create the session
        sleep 0.1

        # Parse windows and create them
        window_index=0

        # Get window count first
        window_count=$(echo "$windows_yaml" | yq -r 'length')

        for ((i=0; i<window_count; i++)); do
            name=$(echo "$windows_yaml" | yq -r ".[$i].name")
            command=$(echo "$windows_yaml" | yq -r ".[$i].command // \"\"")

            # Replace template variables
            command=$(echo "$command" | sed "s|{{ai_cli}}|$ai_cli|g")

            # For AI window, append prompt file as initial message
            if [ "$name" = "ai" ] && [ -n "$processed_prompt" ] && [ -f "$processed_prompt" ]; then
                prompt_file_path="$processed_prompt"
            fi

            if [ $i -eq 0 ]; then
                # First window already exists, just rename it
                window_target=$(tmux list-windows -t "$session_name" -F '#{window_id}' | head -1)
                tmux rename-window -t "$window_target" "$name"
            else
                # Create new window with explicit start directory
                window_target=$(tmux new-window -t "$session_name" -n "$name" -c "$target_dir" -P -F '#{window_id}')
            fi

            # Small delay to ensure window is fully created
            sleep 0.1


            # Execute command if specified
            if [ -n "$command" ] && [ "$command" != "null" ] && [ "$command" != '""' ]; then
                # For AI window, copy prompt to target dir and pass as argument
                if [ -n "${prompt_file_path:-}" ]; then
                    cp "$prompt_file_path" "$target_dir/.workflow-prompt"
                    command="$command \"\$(cat .workflow-prompt)\""
                    prompt_file_path=""
                fi
                sleep 0.3
                tmux send-keys -t "$window_target" "$command" C-m
                if [ "$name" = "ai" ]; then
                    fail_on_trust_dialog "$window_target" 30 || trust_blocked=true
                fi
            fi
        done

        # Switch to first window
        tmux select-window -t "$session_name:1"

        if [ "${trust_blocked:-false}" = true ]; then
            echo "Session $session_name is up but Claude has not started: answer the trust dialog in its ai window." >&2
            exit 1
        fi

        # Switch to the session (unless detached)
        if [ "$detached" = false ]; then
            if [ -n "${TMUX:-}" ]; then
                tmux switch-client -t "$session_name"
            else
                tmux attach-session -t "$session_name"
            fi
        fi

    fi
else
    # Fall back to basic session creation with just shell window
    # Use custom session name if provided, otherwise use directory basename
    if [ -n "$custom_session_name" ]; then
        session_name="$custom_session_name"
    else
        session_name=$(basename "$target_dir")
    fi
    existing_for_dir=$(session_for_path "$target_dir")
    [ -n "$existing_for_dir" ] && session_name="$existing_for_dir"

    if tmux has-session -t "=$session_name" 2>/dev/null; then
        echo "Session $session_name already exists" >&2
        if [ "$detached" = false ]; then
            echo "Switching to it" >&2
            if [ -n "${TMUX:-}" ]; then
                tmux switch-client -t "$session_name"
            else
                tmux attach-session -t "$session_name"
            fi
        fi
    else
        # Create basic session with shell window
        tmux new-session -d -s "$session_name" -c "$target_dir"
        tmux rename-window -t "$session_name:1" "shell"

        # Switch to the session (unless detached)
        if [ "$detached" = false ]; then
            if [ -n "${TMUX:-}" ]; then
                tmux switch-client -t "$session_name"
            else
                tmux attach-session -t "$session_name"
            fi
        fi
    fi
fi

echo "Started $workflow_name workflow in $(basename "$target_dir")" >&2
